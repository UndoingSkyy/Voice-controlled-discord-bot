{
  "name": "earshot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Earshot — a real-time voice bot for Discord: talk to it, and moderate your server by voice. Powered by the Google Gemini Live API.",
  "main": "src/index.js",
  "keywords": [
    "discord",
    "discord-bot",
    "gemini",
    "gemini-live-api",
    "voice",
    "speech-to-speech",
    "voice-assistant"
  ],
  "scripts": {
    "start": "node src/index.js",
    "deploy": "node src/deploy-commands.js",
    "test:gemini": "node src/test-gemini.js",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@google/genai": "^1.9.0",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "ffmpeg-static": "^5.3.0",
    "libsodium-wrappers": "^0.7.15",
    "opusscript": "^0.0.8",
    "prism-media": "^1.3.5"
  },
  "engines": {
    "node": ">=20"
  }
}
