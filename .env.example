# Discord bot token — https://discord.com/developers/applications
DISCORD_TOKEN=
# Application ID (same page, "General Information")
DISCORD_CLIENT_ID=

# Google AI Studio key (free tier) — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Live-API model. Free-tier friendly options:
#   gemini-2.5-flash-native-audio-latest   (native audio, recommended)
#   gemini-3.1-flash-live-preview           (newest)
GEMINI_MODEL=gemini-2.5-flash-native-audio-latest

# Prebuilt voice: Puck, Charon, Kore, Fenrir, Aoede, Leda, Orus, Zephyr
GEMINI_VOICE=Puck

SYSTEM_PROMPT=You are a voice assistant in a Discord voice channel. Answer what people ask, directly and with real detail, then stop talking. Do not ask follow-up questions and do not offer to do more.

# Set to 1 to log moderation actions without performing them. Use this while
# you're tuning how well it hears names.
MOD_DRY_RUN=

# Set to 1 to trace the voice handshake when debugging connection problems.
DEBUG_VOICE=

# Discord end-to-end encryption (DAVE). Leave empty: turning it off makes the
# voice gateway refuse the connection. Set to 0 only to experiment.
DAVE_ENCRYPTION=

# Needed for "what is X playing?". Requires enabling BOTH Presence Intent and
# Server Members Intent in the Developer Portal first, or the bot won't log in.
ENABLE_PRESENCE=

# --- Microphone gating (fixes noise and speaker confusion) ---
# RMS level that counts as speech. Raise it in a noisy room, lower it if quiet
# talkers get cut off. Silence sits near 35, keyboard noise near 170, speech
# well above 1000. Run with DEBUG_GATE=1 to see live levels.
NOISE_GATE_RMS=500
# How long sound must stay above the threshold before it counts as speech.
MIN_SPEECH_MS=120
# How long the gate stays open through natural pauses between words.
SPEECH_HANGOVER_MS=700
# How long one person keeps the floor before someone else can take over.
FLOOR_RELEASE_MS=800
# Set to 1 to log gate decisions and speaker changes.
DEBUG_GATE=

# Name that wakes the bot, e.g. Kamiya. Leave empty and it replies to everything
# it hears, which gets noisy fast in a busy channel.
WAKE_WORD=
# After being addressed, it keeps replying this long so follow-ups need no name.
WAKE_FOLLOWUP_SEC=45

# Let the bot comment when someone starts a game or puts music on.
# Needs ENABLE_PRESENCE=1 as well.
PROACTIVE_ACTIVITY=
# Minimum gap between comments about the same person.
ACTIVITY_COOLDOWN_MIN=10

# Read messages typed in the /join channel out loud, for people who are gaming.
# Requires the Message Content Intent in the Developer Portal.
READ_MESSAGES=
# Minimum seconds between two messages being read, so a busy chat can't spam.
READ_MIN_GAP_SEC=2
# Longer messages are truncated rather than read in full.
READ_MAX_CHARS=300
# Set to 1 to log which messages were read or skipped.
DEBUG_READ=

# Greet people who join the voice channel, and new server members.
# Needs the Server Members Intent for the new-member greeting.
WELCOME_VOICE=
WELCOME_COOLDOWN_MIN=5

# Spoken-profanity auto-moderation: warn on the first offence, mute on the next.
PROFANITY_FILTER=
# Comma-separated override. Otherwise profanity.txt is used, else a small default.
PROFANITY_WORDS=
# A clean stretch this long wipes a user's strikes.
PROFANITY_DECAY_MIN=60
# How long an automatic mute lasts before it lifts itself.
PROFANITY_MUTE_MIN=5
# Set to 1 to log why an activity comment did or did not happen.
DEBUG_ACTIVITY=

# waifu.im image API. Usually works without a token, but Cloudflare may
# challenge unauthenticated requests - get one at https://waifu.im/dashboard
WAIFU_TOKEN=
# Minimum seconds between images in one server.
WAIFU_COOLDOWN_SEC=3
# auto = try waifu.im then fall back to nekos.life. Also: waifu.im, nekos.life
WAIFU_PROVIDER=auto

# Destructive actions (delete/disconnect/timeout) need a spoken yes first.
# Set to 0 to let them run on the first request instead.
MOD_CONFIRM_DESTRUCTIVE=1
# How long a pending confirmation stays valid.
MOD_CONFIRM_TTL_SEC=120

# Live sessions expire after ~10 min; the bot reconnects and resumes the
# conversation automatically. Attempts before it gives up and asks for /join.
GEMINI_MAX_RECONNECT=5

# Google Search grounding. On by default - it needs no extra API key. The
# spoken answer stays short; the full answer and its sources go to the channel.
# Set to 0 to disable (also saves free-tier quota).
WEB_SEARCH=

# Folder of audio files the bot can play. Drop mp3/flac/wav/ogg files in here.
MUSIC_DIR=
# Playback volume, 0 to 1.
MUSIC_VOLUME=0.5
# How far music drops while the bot is speaking (0.2 = 20% of volume).
MUSIC_DUCK=0.2
